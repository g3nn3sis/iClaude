#!/usr/bin/env bash
# Host-side control script for iClaude. Run from the repository directory.
set -euo pipefail

cd "$(dirname "$(readlink -f "$0")")"

die() { echo "iclaude: $*" >&2; exit 1; }

command -v docker >/dev/null 2>&1 || die "Docker is not installed. See https://docs.docker.com/engine/install/"
docker compose version >/dev/null 2>&1 || die "Docker Compose v2 is missing (the 'docker compose' plugin)."
docker info >/dev/null 2>&1 || die "Cannot reach the Docker daemon. Is it running, and is your user in the 'docker' group?"

compose() { docker compose "$@"; }
running() { [ -n "$(compose ps --status running -q iclaude 2>/dev/null)" ]; }
in_container() {
  local flags=()
  [ -t 0 ] && [ -t 1 ] || flags=(-T)
  if running; then
    compose exec "${flags[@]}" iclaude iclaude-container "$@"
  else
    compose run --rm "${flags[@]}" iclaude "$@"
  fi
}

usage() {
  cat <<'EOF'
Usage: ./iclaude <command>

  setup            Inkbox setup wizard and contact allowlist (stops the bridge while it runs)
  login            Log in to Claude with your Pro/Max subscription
  allow [contact]  Show or add authorised contacts (+E.164 phone or email); --remove, --replace
  model [claude|openrouter]    Claude subscription (default) or OpenRouter models: --model, --fast
  replies [natural|single]     Heads-up, updates and short texts, or one message per reply
  auto-mode [on|off|status]    Claude Code auto mode: a safety classifier approves routine actions
  approve [on|off <category...>]  Actions that run without asking first: calendar, email, deploy, delete, pay, all
  start            Build if needed and start iClaude in the background
  stop             Stop iClaude
  restart          Restart iClaude
  status           Container state, health and preflight checks
  check [names]    Preflight checks only (exit code 0 when they pass)
  logs [-f]        Show bridge logs
  doctor           Full diagnostics (iClaude + Inkbox bridge doctor)
  connectors       Which Claude connectors (GitHub, Fastmail, Vercel, Cloudflare...) the bridge can use
  update           Pull the latest iClaude, rebuild and restart (rolls back if checks fail)
  auto-update [on|off|status]  Daily automatic updates via cron
  alerts [action]  Unprompted iMessages: email, calendar, usage, GitHub, Vercel, Cloudflare
  briefing [on --at 08:00|off|test]  Daily morning briefing
  reminders [list|cancel ID]   Reminders you set by texting iClaude
  voice [openai|inkbox]        How phone calls are answered
  backup [file] [--with-workspace]  Save login, config and conversations to a file
  restore <file>               Restore a backup (replaces current data)
  reset [--yes]                Forget conversations, memory and workspace; keep logins and config
  uninstall [--purge]          Remove iClaude; --purge also deletes your data
  shell            Open a shell inside the container
EOF
}

cmd="${1:-help}"
[ $# -gt 0 ] && shift

case "$cmd" in
  setup)
    if running; then compose stop iclaude; fi
    compose run --rm iclaude setup || true
    compose up -d
    ;;
  login)
    compose run --rm iclaude login
    if running; then compose restart iclaude; fi
    ;;
  allow)
    in_container allow "$@"
    if [ $# -gt 0 ] && running; then compose restart iclaude; fi
    ;;
  start) compose up -d --build ;;
  stop) compose stop ;;
  restart) compose restart ;;
  status)
    compose ps
    in_container check || true
    ;;
  check) in_container check "$@" ;;
  logs) compose logs --tail=200 "$@" iclaude ;;
  doctor) in_container doctor ;;
  connectors) in_container connectors ;;
  update) exec "$PWD/scripts/update.sh" "$@" ;;
  auto-update)
    cron_mark="# iclaude-auto-update"
    log_file="${XDG_STATE_HOME:-$HOME/.local/state}/iclaude/update.log"
    case "${1:-status}" in
      on|enable)
        command -v crontab >/dev/null 2>&1 || die "cron is not installed. Install it with: sudo apt-get install -y cron"
        mkdir -p "$(dirname "$log_file")"
        minute="$(crontab -l 2>/dev/null | grep -F "$cron_mark" | awk '{print $1; exit}' || true)"
        line="${minute:-$((RANDOM % 60))} 4 * * * $PWD/scripts/update.sh --auto >> $log_file 2>&1 $cron_mark"
        { crontab -l 2>/dev/null | grep -vF "$cron_mark" || true; echo "$line"; } | crontab -
        echo "Auto-update on: checks daily at 04:$(printf %02d "${line%% *}") server time. Log: $log_file"
        ;;
      off|disable)
        if command -v crontab >/dev/null 2>&1; then
          { crontab -l 2>/dev/null | grep -vF "$cron_mark" || true; } | crontab -
        fi
        echo "Auto-update off."
        ;;
      status)
        if command -v crontab >/dev/null 2>&1 && crontab -l 2>/dev/null | grep -qF "$cron_mark"; then
          echo "Auto-update is on."
        else
          echo "Auto-update is off. Turn it on with: iclaude auto-update on"
        fi
        if [ -f "$log_file" ]; then echo "Recent updates:"; tail -n 5 "$log_file"; fi
        ;;
      *) die "Usage: iclaude auto-update [on|off|status]" ;;
    esac
    ;;
  alerts|briefing|voice|approve|auto-mode|replies|model)
    in_container "$cmd" "$@"
    case "${1:-status}" in status|test) ;; *) if running; then compose restart iclaude; fi ;; esac
    ;;
  reminders) in_container reminders "$@" ;;
  backup)
    out="" paths="home/iclaude"
    for arg in "$@"; do
      case "$arg" in
        --with-workspace) paths="home/iclaude workspace" ;;
        -*) die "Usage: iclaude backup [file] [--with-workspace]" ;;
        *) out="$arg" ;;
      esac
    done
    out="${out:-iclaude-backup-$(date +%Y%m%d-%H%M%S).tar.gz}"
    was_running=0
    if running; then was_running=1; compose stop iclaude; fi
    # shellcheck disable=SC2086
    (umask 077 && compose run --rm -T --entrypoint tar iclaude -czf - -C / $paths > "$out") || { rm -f "$out"; die "Backup failed."; }
    if [ "$was_running" -eq 1 ]; then compose up -d; fi
    echo "Saved $out ($(du -h "$out" | cut -f1)). It contains your logins and tokens: keep it private."
    ;;
  restore)
    file="${1:-}"
    [ -f "$file" ] || die "Usage: iclaude restore <backup file>"
    contents="$(tar -tzf "$file" 2>/dev/null)" || die "$file is not a readable backup."
    grep -q '^home/iclaude/' <<<"$contents" || die "$file is not an iClaude backup."
    workspace=0
    if grep -q '^workspace/' <<<"$contents"; then workspace=1; fi
    echo "Restoring replaces your current login, config and conversations$([ "$workspace" -eq 1 ] && echo ", and the workspace") with $file."
    { : </dev/tty; } 2>/dev/null || die "No terminal to confirm on."
    read -r -p "Type restore to continue: " answer </dev/tty
    [ "$answer" = "restore" ] || { echo "Nothing was changed."; exit 0; }
    if running; then compose stop iclaude; fi
    # shellcheck disable=SC2016
    compose run --rm -T -e WORKSPACE="$workspace" --entrypoint sh iclaude -c \
      'find /home/iclaude -mindepth 1 -delete && if [ "$WORKSPACE" = 1 ]; then find /workspace -mindepth 1 -delete; fi && tar -xzf - -C /' < "$file"
    compose up -d
    echo "Restored."
    ;;
  reset)
    [ $# -eq 0 ] || [ "$1" = "--yes" ] || die "Usage: iclaude reset [--yes]"
    cat <<'EOF'
Factory reset deletes:
  - every conversation and Claude session, and Claude's memory
  - all files in the workspace (/workspace)
  - your edits to ~/.claude/CLAUDE.md (the default comes back)
It keeps your Claude login, Inkbox setup, authorised contacts and gh login.
Inkbox's own per-contact memories are stored by Inkbox and are not touched.
EOF
    if [ "${1:-}" != "--yes" ]; then
      { : </dev/tty; } 2>/dev/null || die "No terminal to confirm on. Re-run with --yes."
      read -r -p "Type reset to continue: " answer </dev/tty
      [ "$answer" = "reset" ] || { echo "Nothing was changed."; exit 0; }
    fi
    if running; then compose stop iclaude; fi
    compose run --rm -T iclaude reset --yes
    compose up -d
    ;;
  uninstall) exec "$PWD/uninstall.sh" "$@" ;;
  shell) in_container shell ;;
  help|-h|--help) usage ;;
  *) usage; exit 1 ;;
esac
