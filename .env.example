# Optional Docker Compose settings for iClaude. Copy to .env to change them.
# Inkbox and Claude credentials never go here: setup stores them inside the
# private "home" volume (/home/iclaude/.inkbox-claude/.env and ~/.claude).

# Time zone for logs and for Claude's sense of "today".
TZ=UTC

# Override the Claude model used for bridged sessions (blank = Claude Code default).
CLAUDE_MODEL=

# Let every authorised contact share Claude's auto memory. Leave false unless they all
# may see each other's remembered facts (it only matters with more than one contact).
ICLAUDE_SHARED_MEMORY=false

# Image tag and base image used by `./iclaude start` / `./iclaude update`.
ICLAUDE_IMAGE=iclaude:local
ICLAUDE_BASE_IMAGE=node:22-bookworm-slim

# Email alerts are configured with `iclaude alerts`, which writes these to the bridge .env
# inside the home volume, not to this file:
#   ICLAUDE_ALERTS, ICLAUDE_ALERT_TO, ICLAUDE_ALERT_INTERVAL (minutes, default 10),
#   ICLAUDE_ALERT_MODEL (default haiku), FASTMAIL_API_TOKEN (read-only Email scope)
